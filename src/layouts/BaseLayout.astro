---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import "../styles/world.css";
import { courseInfo, derinInfo } from "../lib/course";
import { sourceStats } from "../lib/sources";

interface Props {
  title: string;
  description?: string;
  pagefindIgnore?: boolean;
}

const { title, description, pagefindIgnore = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const fullTitle = path === "/" ? title : `${title} · ML Yolu`;
const desc =
  description ??
  `ML Mühendisliği Yolu: ${courseInfo.units} ünite, ${courseInfo.lessons} ders, ${courseInfo.terms} terim; ayrıca ${derinInfo.lessons} derslik derinleşme.`;

const nav = [
  { href: "/", label: "Ağ", match: (p: string) => p === "/" || p.startsWith("/ders") || p.startsWith("/unite") || p.startsWith("/hat") },
  { href: "/derin", label: "Derinleşme", match: (p: string) => p.startsWith("/derin") },
  { href: "/plan", label: "Plan", match: (p: string) => p.startsWith("/plan") },
  { href: "/rehber", label: "Rehber", match: (p: string) => p.startsWith("/rehber") },
  { href: "/kaynaklar", label: "Kaynaklar", match: (p: string) => p.startsWith("/kaynaklar") },
  { href: "/sozluk", label: "Sözlük", match: (p: string) => p.startsWith("/sozluk") },
  { href: "/arama", label: "Arama", match: (p: string) => p.startsWith("/arama") },
];

const href = (value: string) => `${base}${value}`;
const minutes = courseInfo.minutes;
const hourLabel = Math.round(minutes / 60).toLocaleString("tr-TR");
---

<!doctype html>
<html lang="tr" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f4fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050a14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("mlyol.theme");
          const dark =
            saved === "dark" || !saved;
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <header class="masthead" data-pagefind-ignore>
      <div class="masthead-inner">
        <a class="wordmark" href={href("/")} aria-label="ML Yolu, yol haritası">
          <svg class="wordmark-mark" viewBox="0 0 28 20" aria-hidden="true"><path d="M3 4 14 10 3 16M14 10 25 4M14 10 25 16" /><circle cx="3" cy="4" r="2.4" /><circle cx="3" cy="16" r="2.4" /><circle cx="14" cy="10" r="3" /><circle cx="25" cy="4" r="2.4" /><circle cx="25" cy="16" r="2.4" /></svg>
          ML Yolu
        </a>
        <nav aria-label="Ana gezinme">
          {
            nav.map((item) => (
              <a
                class="nav-link"
                href={href(item.href)}
                aria-current={
                  item.match(path)
                    ? item.href === "/" && path !== "/"
                      ? "true"
                      : "page"
                    : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Temayı değiştir">
            <svg class="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
            </svg>
          </button>
          <button
            class="icon-btn menu-btn"
            id="menu-toggle"
            type="button"
            aria-label="Menü"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M3 6h18M3 12h18M3 18h18"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <div class="mobile-nav" id="mobile-nav" data-open="false" data-pagefind-ignore>
      {
        nav.map((item) => (
          <a href={href(item.href)}>
            {item.label}
            <span>
              {item.href === "/sozluk"
                ? `${courseInfo.terms} terim`
                : item.href === "/kaynaklar"
                  ? `${sourceStats.entries} kayıt`
                  : item.href === "/rehber"
                    ? "4 senaryo"
                    : ""}
            </span>
          </a>
        ))
      }
      <a href={href("/hakkinda")}>Site ve kaynak <span>bilgi</span></a>
    </div>

    <main id="main" data-pagefind-ignore={pagefindIgnore ? "" : undefined}>
      <slot />
    </main>

    <footer class="site-foot" data-pagefind-ignore>
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <span class="label">Kaynak</span>
            <p>
              Bütün ders metni <code>ders-ml-yol.json</code> ve <code>ders-ml-derin.json</code> dosyalarından olduğu gibi
              render edilir. Site metni yeniden yazmaz, özetlemez veya yeni ders
              üretmez. Sözlük, kontrol soruları ve süreler aynı dosyadan gelir.
            </p>
          </div>
          <div>
            <span class="label">Kapsam</span>
            <div class="foot-links">
              <a href={href("/hakkinda")}>Veri, kapsam ve yöntem</a>
              <a href={href("/rehber")}>Derinleşme rehberi</a>
              <a href={href("/kaynaklar")}>Bütün kaynaklar</a>
              <a href={href("/plan")}>Çalışma planı</a>
              <a href={href("/sozluk")}>Sözlük</a>
            </div>
          </div>
          <div>
            <span class="label">Rakamlar</span>
            <p class="num">
              {courseInfo.units} ünite · {courseInfo.lessons} ders · {courseInfo.pages} sayfa<br />
              {courseInfo.minutes.toLocaleString("tr-TR")} dk yazılı süre ({hourLabel} sa) ·{" "}
              {courseInfo.terms} terim
            </p>
          </div>
        </div>
        <div class="foot-base">
          <span>ML Yolu · kişisel çalışma sitesi</span>
          <span>İlerleme yalnız bu tarayıcıda saklanır</span>
        </div>
      </div>
    </footer>

    <div class="term-scrim" id="term-scrim" data-open="false" aria-hidden="true"></div>
    <aside
      class="term-panel"
      id="term-panel"
      data-open="false"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="term-title"
      inert
    >
      <div class="term-panel-head">
        <span class="label">Sözlük</span>
        <button class="icon-btn" type="button" id="term-close" aria-label="Terim panelini kapat">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </button>
      </div>
      <div class="term-panel-body" id="term-body"></div>
    </aside>

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
