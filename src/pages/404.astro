---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (value: string) => `${base}${value}`;
---

<BaseLayout title="Sayfa bulunamadı" pagefindIgnore>
  <div class="wrap notfound">
    <h1>404</h1>
    <p>
      Bu adreste bir ders, ünite veya hat yok. Adres yanlış yazılmış olabilir ya da
      müfredat dosyası güncellenmiş olabilir.
    </p>
    <div class="home-actions">
      <a class="btn" href={href("/")}>Yol haritasına dön <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={href("/arama")}>Ara</a>
    </div>
  </div>
</BaseLayout>
